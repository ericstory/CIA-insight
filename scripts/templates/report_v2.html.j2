      <td class="url-cell">
        <a href="https://www.google.com/search?q={{ k.keyword }}" target="_blank">🔍</a>
      </td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
</section>

<!-- ══════════ GOLDEN KW ══════════ -->
<section class="page-section" data-route="/keywords/golden">
  <div class="page-head">
    <h2>⭐ Golden Keywords</h2>
    <div class="sub">vol ≥ 200 · KD ≤ 35 · CPC ≥ $1 — 立即可投/可做</div>
