<!DOCTYPE html>
<html lang="zh-Hans">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CIA — {{ topic }}</title>
<link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.dataTables.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.2.0/css/buttons.dataTables.min.css">
<style>
:root {
  --fg:#1f2328; --muted:#57606a; --bg:#f6f8fa; --card:#ffffff;
  --border:#d0d7de; --soft:#eaf0f8;
  --blue:#0969da; --green:#1a7f37; --orange:#9a6700; --red:#cf222e;
  --sidebar-w:220px;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC",sans-serif;
     background:var(--bg);color:var(--fg);line-height:1.55;display:flex;min-height:100vh}

/* ── SIDEBAR ── */
#sidebar{
  width:var(--sidebar-w);min-width:var(--sidebar-w);background:#fff;
  border-right:1px solid var(--border);position:fixed;top:0;left:0;
  height:100vh;overflow-y:auto;display:flex;flex-direction:column;z-index:200;
  padding-bottom:24px;
}
.sidebar-brand{padding:16px 18px 12px;border-bottom:1px solid var(--border)}
.sidebar-brand .logo{font-weight:700;font-size:15px;color:var(--fg)}
.sidebar-brand .topic{font-size:11px;color:var(--muted);margin-top:2px;
                       white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nav-section{padding:10px 0 4px 14px;font-size:10px;font-weight:600;
             color:var(--muted);text-transform:uppercase;letter-spacing:.6px}
.nav-item{display:flex;align-items:center;justify-content:space-between;
          padding:6px 14px 6px 18px;font-size:13px;color:var(--fg);
          text-decoration:none;cursor:pointer;border-left:3px solid transparent}
.nav-item:hover{background:var(--soft)}
.nav-item.active{border-left-color:var(--blue);color:var(--blue);
                 background:var(--soft);font-weight:500}
.nav-badge{background:var(--soft);color:var(--muted);border-radius:10px;
           padding:1px 7px;font-size:10px;font-weight:500}
.nav-item.active .nav-badge{background:#dbeafe;color:var(--blue)}

/* ── MAIN ── */
#main{margin-left:var(--sidebar-w);flex:1;min-width:0;padding:28px 32px 60px}
.page-section{display:none}
.page-section.active{display:block}

/* ── PAGE HEADER ── */
.page-head{margin-bottom:20px;padding-bottom:14px;border-bottom:1px solid var(--border)}
.page-head h2{font-size:20px;font-weight:700;margin-bottom:4px}
.page-head .sub{color:var(--muted);font-size:13px}
.breadcrumb{font-size:12px;color:var(--muted);margin-bottom:8px}
.breadcrumb a{color:var(--blue);text-decoration:none}

/* ── KPI CARDS ── */
.kpi-row{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:24px}
.kpi{background:var(--card);border:1px solid var(--border);border-radius:10px;
     padding:14px 18px;min-width:120px;flex:1}
.kpi-num{font-size:24px;font-weight:700;color:var(--blue);line-height:1}
.kpi-label{font-size:11px;color:var(--muted);text-transform:uppercase;
            letter-spacing:.5px;margin-top:4px}

/* ── ENTRY CARDS (overview shortcuts) ── */
.entry-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px;margin-top:20px}
.entry-card{background:var(--card);border:1px solid var(--border);border-radius:10px;
            padding:16px;text-decoration:none;color:var(--fg);
            transition:transform .12s,box-shadow .12s;display:block}
.entry-card:hover{transform:translateY(-2px);box-shadow:0 4px 16px rgba(0,0,0,.07)}
.entry-card .ec-icon{font-size:22px;margin-bottom:8px}
.entry-card .ec-title{font-weight:600;font-size:14px}
.entry-card .ec-count{font-size:12px;color:var(--muted);margin-top:4px}

/* ── SYNTHESIS ── */
.synthesis{background:var(--card);border:1px solid var(--border);border-radius:10px;
           padding:28px 36px;margin-bottom:24px;max-width:900px}
.synthesis h1{font-size:20px;margin:24px 0 10px;padding-bottom:6px;
              border-bottom:2px solid var(--border);font-weight:700}
.synthesis h1:first-child{margin-top:0}
.synthesis h2{font-size:16px;margin:18px 0 8px;font-weight:600;
              padding-left:10px;border-left:3px solid var(--blue)}
.synthesis h3{font-size:14px;margin:14px 0 6px;font-weight:600;color:var(--muted)}
.synthesis p{margin:8px 0;font-size:14px}
.synthesis table{border-collapse:collapse;width:100%;font-size:13px;margin:12px 0}
.synthesis table th{background:var(--soft);padding:6px 10px;text-align:left;
                     border:1px solid var(--border);font-weight:600}
.synthesis table td{padding:6px 10px;border:1px solid var(--border)}
.synthesis code{background:var(--soft);padding:1px 5px;border-radius:3px;font-size:12px}
.synthesis pre{background:var(--soft);padding:12px;border-radius:6px;overflow-x:auto;
               font-size:12px;margin:10px 0}

/* ── TIKTOK CARDS ── */
.card-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px}
.tt-card{background:var(--card);border:1px solid var(--border);border-radius:10px;
         padding:14px;text-decoration:none;color:var(--fg);display:block;
         transition:transform .12s,box-shadow .12s}
.tt-card:hover{transform:translateY(-2px);box-shadow:0 4px 16px rgba(0,0,0,.07)}
.tt-meta{display:flex;gap:10px;align-items:center;margin-bottom:8px;flex-wrap:wrap}
.metric{font-size:13px;font-weight:600}
.metric.primary{color:var(--fg)}
.metric.hot{color:var(--red)}
.metric.muted{color:var(--muted);font-weight:400}
.tt-text{font-size:13px;line-height:1.45;color:var(--fg);margin-bottom:8px}
.tt-foot{font-size:11px;color:var(--muted);display:flex;justify-content:space-between;
          align-items:center}
.chip{background:var(--soft);border:1px solid var(--border);border-radius:12px;
      padding:2px 8px;font-size:11px;color:var(--muted)}
.chip-hot{background:#fef2f2;border-color:#fecaca;color:var(--red)}
.chip-ok{background:#f0fdf4;border-color:#bbf7d0;color:var(--green)}

/* ── YOUTUBE CARDS ── */
.yt-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px}
.yt-card{background:var(--card);border:1px solid var(--border);border-radius:10px;
         overflow:hidden;text-decoration:none;color:var(--fg);
         transition:transform .12s,box-shadow .12s;display:block}
.yt-card:hover{transform:translateY(-2px);box-shadow:0 4px 16px rgba(0,0,0,.07)}
.yt-thumb{position:relative;aspect-ratio:16/9;background:#0f0f0f;overflow:hidden}
.yt-thumb img{width:100%;height:100%;object-fit:cover;display:block}
.yt-thumb-fb{width:100%;height:100%;display:flex;align-items:center;justify-content:center;
              font-size:32px;color:#aaa}
.yt-dur{position:absolute;bottom:6px;right:6px;background:rgba(0,0,0,.85);
        color:#fff;padding:2px 6px;border-radius:3px;font-size:11px;font-weight:500}
.yt-body{padding:10px 12px}
.yt-title{font-weight:600;font-size:13px;line-height:1.35;margin-bottom:5px;
          display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.yt-channel{font-size:11px;color:var(--muted);margin-bottom:4px}
.yt-stats{font-size:11px;color:var(--muted)}
.yt-stats b{color:var(--fg);font-variant-numeric:tabular-nums}
.yt-query{display:inline-block;margin-top:6px}

/* ── FILTER CHIPS ── */
.filter-bar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
.filter-chip{background:var(--card);border:1px solid var(--border);border-radius:16px;
             padding:4px 12px;font-size:12px;cursor:pointer;color:var(--muted);
             transition:all .12s;white-space:nowrap}
.filter-chip:hover{border-color:var(--blue);color:var(--blue)}
.filter-chip.active{background:var(--blue);border-color:var(--blue);color:#fff;font-weight:500}

/* ── KD BADGES ── */
.kd-easy{background:#d1fae5;color:#065f46;border-radius:4px;padding:1px 6px;font-size:11px;font-weight:600}
.kd-med{background:#fef3c7;color:#92400e;border-radius:4px;padding:1px 6px;font-size:11px;font-weight:600}
.kd-hard{background:#fee2e2;color:#991b1b;border-radius:4px;padding:1px 6px;font-size:11px;font-weight:600}
.intent-transactional,.intent-commercial{background:#d1fae5;color:#065f46;border-radius:4px;padding:1px 6px;font-size:11px}
.intent-informational{background:#f0f9ff;color:#0369a1;border-radius:4px;padding:1px 6px;font-size:11px}
.intent-navigational{background:#fef3c7;color:#92400e;border-radius:4px;padding:1px 6px;font-size:11px}

/* ── TABLES ── */
.cia-table{width:100% !important}
.cia-table td,.cia-table th{white-space:nowrap;vertical-align:middle}
.cia-table td.wrap{white-space:normal;max-width:340px;font-size:12px}
.num{text-align:right;font-variant-numeric:tabular-nums}
.url-cell a{color:var(--blue);text-decoration:none;font-size:11px}
.url-cell a:hover{text-decoration:underline}

/* ── TRACK CARDS ── */
.track-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px}
.track-card{background:var(--card);border:1px solid var(--border);border-radius:10px;
            padding:16px;text-decoration:none;color:var(--fg);display:block;
            transition:transform .12s,box-shadow .12s}
.track-card:hover{transform:translateY(-2px);box-shadow:0 4px 16px rgba(0,0,0,.07)}
.track-card .track-id{font-size:11px;color:var(--muted);margin-bottom:4px}
.track-card .track-label{font-size:15px;font-weight:600;margin-bottom:8px}
.track-card .track-meta{font-size:12px;color:var(--muted);display:flex;gap:12px}
.kw-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.kw-tag{background:var(--soft);border:1px solid var(--border);border-radius:10px;
        padding:2px 8px;font-size:11px;color:var(--muted)}

/* ── TRACK TABS ── */
.track-tabs{display:flex;gap:8px;margin-bottom:20px;border-bottom:2px solid var(--border);
            padding-bottom:10px}
.tab-btn{background:none;border:none;padding:6px 14px;font-size:13px;cursor:pointer;
         color:var(--muted);border-radius:6px 6px 0 0;font-family:inherit;
         border-bottom:2px solid transparent;margin-bottom:-12px}
.tab-btn:hover{background:var(--soft);color:var(--fg)}
.tab-btn.active{color:var(--blue);font-weight:600;border-bottom-color:var(--blue)}
.tab-pane{display:none}
.tab-pane.active{display:block}

/* ── REVIEWS ── */
.review-item{background:var(--card);border:1px solid var(--border);border-radius:8px;
             padding:12px 14px;margin-bottom:10px}
.review-stars{color:var(--orange);font-size:13px;margin-bottom:4px}
.review-body{font-size:13px;line-height:1.5;color:var(--fg)}
.review-meta{font-size:11px;color:var(--muted);margin-top:6px}

/* ── SEARCH BAR ── */
.search-bar{width:100%;max-width:360px;padding:7px 12px;border:1px solid var(--border);
            border-radius:6px;font-size:13px;margin-bottom:14px}

/* ── REDDIT ── */
.reddit-item{background:var(--card);border:1px solid var(--border);border-radius:8px;
             padding:12px 14px;margin-bottom:10px}
.reddit-score{font-weight:700;color:var(--orange);font-size:13px}
.reddit-title{font-size:14px;font-weight:600;margin:4px 0}
.reddit-body{font-size:13px;color:var(--muted);margin-top:4px;line-height:1.45}

/* ── COMP WEB ── */
.comp-bar-wrap{background:var(--soft);border-radius:4px;height:8px;margin-top:4px;width:100%}
.comp-bar{background:var(--blue);height:8px;border-radius:4px}

/* ── BRIEFS ── */
.brief-card{background:var(--card);border:1px solid var(--border);border-radius:10px;
            padding:20px;margin-bottom:20px}
.brief-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:16px}
.brief-card-title{font-size:16px;font-weight:700}
.brief-card-sub{font-size:12px;color:var(--muted);margin-top:2px}
.brief-actions{display:flex;gap:8px;flex-shrink:0}
.btn-copy,.btn-dl{padding:6px 14px;font-size:12px;font-weight:600;border:none;
                  border-radius:6px;cursor:pointer;font-family:inherit;transition:opacity .1s}
.btn-copy{background:#dbeafe;color:#1d4ed8}
.btn-copy:hover{opacity:.8}
.btn-dl{background:#dcfce7;color:#15803d}
.btn-dl:hover{opacity:.8}
.btn-copy.copied{background:#d1fae5;color:#065f46}
.brief-section-label{font-size:11px;font-weight:600;color:var(--muted);
                     text-transform:uppercase;letter-spacing:.06em;margin:14px 0 6px}
.hook-list{display:flex;flex-wrap:wrap;gap:6px}
.hook-tag{background:#eff6ff;border:1px solid #bfdbfe;color:#1d4ed8;border-radius:16px;
          padding:3px 10px;font-size:12px}
.quote-list{margin:0;padding:0;list-style:none}
.quote-list li{font-size:13px;color:var(--fg);padding:3px 0;line-height:1.5}
.quote-list li::before{content:'"';color:var(--muted);margin-right:2px}
.quote-list li::after{content:'"';color:var(--muted);margin-left:2px}
.angle-box{background:var(--soft);border-left:3px solid var(--blue);padding:10px 14px;
           border-radius:0 6px 6px 0;font-size:13px;line-height:1.6;color:var(--fg)}
.hashtag-row{display:flex;flex-wrap:wrap;gap:6px}
.hashtag{background:var(--soft);border-radius:10px;padding:2px 8px;
         font-size:12px;color:var(--muted)}
.brief-raw-toggle{font-size:12px;color:var(--blue);cursor:pointer;margin-top:14px;
                  background:none;border:none;padding:0;font-family:inherit}
.brief-raw{display:none;margin-top:10px}
.brief-raw.open{display:block}
.brief-raw table{font-size:12px;width:100%;border-collapse:collapse}
.brief-raw td,.brief-raw th{padding:5px 8px;border:1px solid var(--border);text-align:left;vertical-align:top}
.brief-raw th{background:var(--soft);font-weight:600}
.brief-raw td a{color:var(--blue);text-decoration:none}

/* ── MOBILE ── */
@media(max-width:768px){
  #sidebar{transform:translateX(-100%);transition:transform .2s}
  #sidebar.open{transform:translateX(0)}
  #main{margin-left:0;padding:16px}
  .hamburger{display:block !important}
}
.hamburger{display:none;position:fixed;top:12px;left:12px;z-index:300;
           background:var(--card);border:1px solid var(--border);border-radius:6px;
           width:36px;height:36px;cursor:pointer;font-size:18px;
           align-items:center;justify-content:center}
</style>
</head>
<body>

<button class="hamburger" id="hamburger" onclick="document.getElementById('sidebar').classList.toggle('open')">☰</button>

<!-- SIDEBAR -->
<nav id="sidebar">
  <div class="sidebar-brand">
    <div class="logo">CIA 情报</div>
    <div class="topic">{{ topic }}</div>
  </div>

  <div class="nav-section">概览</div>
  <a class="nav-item" href="#/overview" data-nav>
    🏠 Overview
    {% if synthesis_html %}<span class="nav-badge">有分析</span>{% endif %}
  </a>
  <a class="nav-item" href="#/tracks" data-nav>
    🗺 赛道 <span class="nav-badge">{{ tracks|length }}</span>
  </a>

  <div class="nav-section">传播侧</div>
  <a class="nav-item" href="#/social/tiktok" data-nav>
    TikTok <span class="nav-badge">{{ stats.social_tiktok }}</span>
  </a>
  <a class="nav-item" href="#/social/youtube" data-nav>
    YouTube <span class="nav-badge">{{ stats.social_youtube }}</span>
  </a>
  <a class="nav-item" href="#/social/reddit" data-nav>
    Reddit <span class="nav-badge">{{ stats.social_reddit }}</span>
  </a>
  {% if briefs %}
  <a class="nav-item" href="#/briefs" data-nav>
    🎬 内容简报 <span class="nav-badge">{{ briefs|length }}</span>
  </a>
  {% endif %}

  <div class="nav-section">需求侧</div>
  <a class="nav-item" href="#/keywords/google" data-nav>
    Google KW <span class="nav-badge">{{ stats.keywords_google }}</span>
  </a>
  {% if kw_golden %}
  <a class="nav-item" href="#/keywords/golden" data-nav>
    ⭐ Golden KW <span class="nav-badge">{{ kw_golden|length }}</span>
  </a>
  {% endif %}
  {% if kw_aso %}
  <a class="nav-item" href="#/keywords/aso" data-nav>
    ASO 词 <span class="nav-badge">{{ stats.appstore_keywords }}</span>
  </a>
  {% endif %}
  {% if kw_gaps %}
  <a class="nav-item" href="#/keywords/gaps" data-nav>
    蓝海词 <span class="nav-badge">{{ kw_gaps|length }}</span>
  </a>
  {% endif %}

  <div class="nav-section">供给侧</div>
  {% if comp_web %}
  <a class="nav-item" href="#/competitors/web" data-nav>
    竞品官网 <span class="nav-badge">{{ comp_web|length }}</span>
  </a>
  {% endif %}
  {% if comp_apps %}
  <a class="nav-item" href="#/competitors/apps" data-nav>
    竞品 App <span class="nav-badge">{{ stats.competitors_app }}</span>
  </a>
  {% endif %}
  {% if reviews %}
  <a class="nav-item" href="#/reviews" data-nav>
    💔 差评 <span class="nav-badge">{{ reviews|length }}</span>
  </a>
  {% endif %}
  {% if ai_vis %}
  <a class="nav-item" href="#/ai-visibility" data-nav>
    AI 引用 <span class="nav-badge">{{ ai_vis|length }}</span>
  </a>
  {% endif %}

  <div class="nav-section">系统</div>
  <a class="nav-item" href="#/log" data-nav>
    Fetch Log <span class="nav-badge">{{ fetch_log|length }}</span>
  </a>

  <div style="padding:16px 14px 0;font-size:11px;color:var(--muted);margin-top:auto">
    生成于 {{ generated_at }}<br>
    总成本 ${{ "%.4f"|format(total_cost) }}
  </div>
</nav>

<!-- MAIN -->
<main id="main">

<!-- ══════════ OVERVIEW ══════════ -->
<section class="page-section" data-route="/overview">
  <div class="page-head">
    <h2>CIA 情报报告</h2>
    <div class="sub">{{ topic }} · {{ generated_at }} · ${{ "%.4f"|format(total_cost) }}</div>
  </div>

  <div class="kpi-row">
    <div class="kpi"><div class="kpi-num">{{ stats.social_tiktok|num }}</div><div class="kpi-label">TikTok</div></div>
    <div class="kpi"><div class="kpi-num">{{ stats.social_youtube|num }}</div><div class="kpi-label">YouTube</div></div>
    <div class="kpi"><div class="kpi-num">{{ stats.keywords_google|num }}</div><div class="kpi-label">Google KW</div></div>
    <div class="kpi"><div class="kpi-num">{{ kw_golden|length }}</div><div class="kpi-label">Golden KW</div></div>
    <div class="kpi"><div class="kpi-num">{{ stats.competitors_app|num }}</div><div class="kpi-label">竞品 App</div></div>
    <div class="kpi"><div class="kpi-num">{{ comp_web|length }}</div><div class="kpi-label">竞品官网</div></div>
    <div class="kpi"><div class="kpi-num">{{ tracks|length }}</div><div class="kpi-label">赛道</div></div>
  </div>

  {% if synthesis_html %}
  <div class="synthesis">{{ synthesis_html|safe }}</div>
  {% endif %}

  <div class="entry-grid">
    {% if tracks %}<a class="entry-card" href="#/tracks" data-nav><div class="ec-icon">🗺</div><div class="ec-title">赛道全景</div><div class="ec-count">{{ tracks|length }} 条赛道</div></a>{% endif %}
    {% if tiktok %}<a class="entry-card" href="#/social/tiktok" data-nav><div class="ec-icon">TikTok</div><div class="ec-title">传播侧 · TikTok</div><div class="ec-count">{{ tiktok|length }} 条视频</div></a>{% endif %}
    {% if youtube %}<a class="entry-card" href="#/social/youtube" data-nav><div class="ec-icon">▶️</div><div class="ec-title">传播侧 · YouTube</div><div class="ec-count">{{ youtube|length }} 条视频</div></a>{% endif %}
    {% if kw_all %}<a class="entry-card" href="#/keywords/google" data-nav><div class="ec-icon">🔍</div><div class="ec-title">Google 关键词</div><div class="ec-count">{{ kw_all|length }} 条</div></a>{% endif %}
    {% if comp_web %}<a class="entry-card" href="#/competitors/web" data-nav><div class="ec-icon">🌐</div><div class="ec-title">竞品官网流量</div><div class="ec-count">{{ comp_web|length }} 个域名</div></a>{% endif %}
    {% if reviews %}<a class="entry-card" href="#/reviews" data-nav><div class="ec-icon">💔</div><div class="ec-title">用户差评</div><div class="ec-count">{{ reviews|length }} 条</div></a>{% endif %}
    {% if briefs %}<a class="entry-card" href="#/briefs" data-nav><div class="ec-icon">🎬</div><div class="ec-title">内容简报</div><div class="ec-count">{{ briefs|length }} 个赛道</div></a>{% endif %}
  </div>
</section>

<!-- ══════════ TRACKS ══════════ -->
<section class="page-section" data-route="/tracks">
  <div class="page-head">
    <h2>🗺 赛道总览对比矩阵</h2>
    <div class="sub">{{ tracks|length }} 条赛道 · 点击赛道名进入三层详情</div>
  </div>
  {% if tracks %}
  <table class="cia-table display" id="dt-tracks-matrix" style="width:100%;margin-bottom:32px">
    <thead>
      <tr>
        <th style="min-width:110px">赛道</th>
        <th style="min-width:90px">市场体量</th>
        <th style="min-width:200px">头部竞品</th>
        <th style="min-width:200px">搜索需求</th>
        <th style="min-width:220px">传播钩子</th>
      </tr>
    </thead>
    <tbody>
    {% for t in tracks|sort(attribute='total_reviews', reverse=True) %}
    <tr>
      {# 赛道名 + 英文名 + LLM描述 + 数量 #}
      <td>
        <a href="#/track/{{ t.id }}" data-nav
           style="font-weight:700;font-size:14px;color:var(--fg);text-decoration:none;display:block;margin-bottom:2px">{{ t.label }}</a>
        {% if t.name_en %}<div style="font-size:10px;color:var(--muted);margin-bottom:4px">{{ t.name_en }}</div>{% endif %}
        {% if t.description %}<div style="font-size:11px;color:var(--fg);line-height:1.4;margin-bottom:5px">{{ t.description }}</div>{% endif %}
        <span style="font-size:10px;color:var(--muted)">{{ t.n_apps }} App · {{ t.n_web }} Web · 📡{{ t.n_tiktok + t.n_youtube + t.n_reddit }}</span>
      </td>

      {# 市场体量：总 review + 均评分 #}
      <td>
        <div style="font-size:18px;font-weight:700;color:var(--blue);line-height:1">{{ t.total_reviews|num }}</div>
        <div style="font-size:11px;color:var(--muted);margin-top:2px">reviews{% if t.avg_rating %} · {{ "%.1f"|format(t.avg_rating) }}★{% endif %}</div>
      </td>

      {# 头部竞品：top 3 app name + review 数 #}
      <td class="wrap">
        {% for a in t.apps[:3] %}
        <div style="margin-bottom:4px;line-height:1.2">
          <span style="font-size:12px;font-weight:600">{{ a.name }}</span>
          <span style="font-size:11px;color:var(--muted)"> {{ (a.review_count or 0)|num }}</span>
        </div>
        {% else %}
        <span style="color:var(--muted);font-size:12px">—</span>
        {% endfor %}
      </td>

      {# 搜索需求：赛道特征词 + 搜索量 + 渠道汇总 #}
      <td class="wrap">
        {% if t.track_keywords_enriched %}
        <div style="display:flex;flex-wrap:wrap;gap:4px;margin-bottom:7px">
          {% for kw in t.track_keywords_enriched[:5] %}
          <span style="background:var(--soft);border:1px solid var(--border);border-radius:10px;
                       padding:2px 7px;font-size:11px;white-space:nowrap">
            {{ kw.keyword }}
            {% if kw.sv %}
            <span style="color:{% if kw.channel=='app' %}var(--green){% else %}var(--blue){% endif %};
                         font-weight:600;margin-left:2px">{{ kw.sv|num }}</span>
            {% endif %}
          </span>
          {% endfor %}
        </div>
        <div style="font-size:11px;color:var(--muted);display:flex;gap:10px">
          {% if t.aso_total_sv %}
          <span>📱 ASO <b style="color:var(--green)">{{ t.aso_total_sv|num }}</b></span>
          {% endif %}
          {% if t.google_total_sv %}
          <span>🔍 Web <b style="color:var(--blue)">{{ t.google_total_sv|num }}</b></span>
          {% endif %}
          {% if not t.aso_total_sv and not t.google_total_sv %}
          <span style="color:var(--muted)">暂无量化数据</span>
          {% endif %}
        </div>
        {% else %}
        <span style="color:var(--muted);font-size:12px">—</span>
        {% endif %}
      </td>

      {# 传播钩子：top TikTok 文本 or YouTube 标题 #}
      <td class="wrap" style="max-width:260px">
        {% if t.tiktok %}
        <div style="font-size:12px;color:var(--fg);line-height:1.4;font-style:italic">"{{ t.tiktok[0].text_short }}"</div>
        <div style="font-size:10px;color:var(--muted);margin-top:2px">TikTok · {{ (t.tiktok[0].plays or 0)|num }} 播放</div>
        {% elif t.youtube %}
        <div style="font-size:12px;color:var(--fg);line-height:1.4;font-style:italic">"{{ t.youtube[0].title }}"</div>
        <div style="font-size:10px;color:var(--muted);margin-top:2px">YouTube · {{ (t.youtube[0].views or 0)|num }} 观看</div>
        {% else %}
        <span style="color:var(--muted);font-size:12px">暂无社交数据</span>
        {% endif %}
      </td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p style="color:var(--muted)">暂无赛道数据。运行 <code>cluster-competitors</code> 后重新导出。</p>
  {% endif %}
</section>

<!-- ══════════ TRACK DETAIL ══════════ -->
{% for t in tracks %}
<section class="page-section" data-route="/track/{{ t.id }}">
  <div class="breadcrumb"><a href="#/tracks" data-nav>赛道总览</a> › 赛道 #{{ t.id }}</div>
  <div class="page-head">
    <h2>{{ t.label }}</h2>
    <div class="sub">赛道 #{{ t.id }} · {{ t.n_apps }} App · {{ t.n_web }} Web · {{ t.n_tiktok + t.n_youtube + t.n_reddit }} 社媒信号</div>
  </div>

  {% if t.top_keywords %}
  <div style="margin-bottom:16px">
    <div style="font-size:12px;color:var(--muted);margin-bottom:6px">核心词</div>
    <div class="kw-tags">{% for kw in t.top_keywords %}{% if kw.strip() %}<span class="kw-tag">{{ kw.strip() }}</span>{% endif %}{% endfor %}</div>
  </div>
  {% endif %}

  <!-- Three-layer tab buttons -->
  <div class="track-tabs">
    <button class="tab-btn active" onclick="switchTab({{ t.id }},'social',this)">
      📡 传播 <span class="nav-badge" style="margin-left:4px">{{ t.n_tiktok + t.n_youtube + t.n_reddit }}</span>
    </button>
    <button class="tab-btn" onclick="switchTab({{ t.id }},'demand',this)">
      🔍 需求 <span class="nav-badge" style="margin-left:4px">{{ t.n_aso_kw + t.n_google_kw }}</span>
    </button>
    <button class="tab-btn" onclick="switchTab({{ t.id }},'supply',this)">
      🏢 供给 <span class="nav-badge" style="margin-left:4px">{{ t.n_apps + t.n_web }}</span>
    </button>
  </div>

  <!-- ── 传播 tab ─────────────────────────────────────── -->
  <div class="tab-pane active" data-tab="social">
    {% if t.tiktok %}
    <h3 style="margin:0 0 10px;font-size:15px">TikTok ({{ t.tiktok|length }})</h3>
    <div class="card-grid" style="margin-bottom:28px">
    {% for v in t.tiktok %}
    <a class="tt-card" href="{{ v.url }}" target="_blank" rel="noopener"
       data-plays="{{ v.plays or 0 }}" data-sr="{{ v.share_rate or 0 }}"
       data-text="{{ (v.text or '')|lower }}" data-author="{{ (v.author or '')|lower }}"
       data-query="{{ (v.query or '')|lower }}">
      <div class="tt-meta">
        <span class="metric primary">▶ {{ (v.plays or 0)|num }}</span>
        <span class="metric {{ 'hot' if v.is_hot else 'muted' }}">
          {% if v.is_hot %}<span class="chip chip-hot">🔥 {{ "%.2f"|format((v.share_rate or 0)*100) }}%</span>
          {% else %}{{ "%.3f"|format((v.share_rate or 0)*100) }}% share{% endif %}
        </span>
        <span class="metric muted">♥ {{ (v.likes or 0)|num }}</span>
      </div>
      <div class="tt-text">{{ v.text_short }}</div>
      {% if v.text_zh %}<div style="font-size:11px;color:var(--muted);margin-top:4px;line-height:1.4;font-style:italic">{{ v.text_zh }}</div>{% endif %}
      <div class="tt-foot" style="margin-top:6px">
        <span style="color:var(--muted)">@{{ v.author or "—" }}</span>
        <span class="chip">{{ v.query or "" }}</span>
      </div>
    </a>
    {% endfor %}
    </div>
    {% endif %}

    {% if t.youtube %}
    <h3 style="margin:0 0 10px;font-size:15px">YouTube ({{ t.youtube|length }})</h3>
    <div class="yt-grid" style="margin-bottom:28px">
    {% for v in t.youtube %}
    <a class="yt-card" href="{{ v.url }}" target="_blank" rel="noopener">
      <div class="yt-thumb">
        {% if v.video_id %}
        <img src="https://img.youtube.com/vi/{{ v.video_id }}/mqdefault.jpg"
             loading="lazy" alt="" width="320" height="180"
             onerror="this.parentNode.innerHTML='<div class=yt-thumb-fb>▶</div>'">
        {% else %}
        <div class="yt-thumb-fb">▶</div>
        {% endif %}
        {% if v.duration_seconds %}<span class="yt-dur">{{ v.duration_seconds|hms }}</span>{% endif %}
      </div>
      <div class="yt-body">
        <div class="yt-title">{{ v.title }}</div>
        {% if v.title_zh %}<div style="font-size:11px;color:var(--muted);margin-top:2px;font-style:italic">{{ v.title_zh }}</div>{% endif %}
        <div class="yt-channel" style="margin-top:4px">{{ v.channel }}</div>
        <div class="yt-stats"><b>{{ (v.views or 0)|num }}</b> 次观看 · {{ (v.likes or 0)|num }} ♥</div>
        {% if v.query %}<span class="chip yt-query">{{ v.query }}</span>{% endif %}
      </div>
    </a>
    {% endfor %}
    </div>
    {% endif %}

    {% if t.reddit %}
    <h3 style="margin:0 0 10px;font-size:15px">Reddit ({{ t.reddit|length }})</h3>
    {% for r in t.reddit %}
    <div class="reddit-item">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:4px">
        <span class="reddit-score">↑ {{ (r.score or 0)|num }}</span>
        <span class="chip">r/{{ r.subreddit }}</span>
        {% if r.query %}<span class="chip">{{ r.query }}</span>{% endif %}
      </div>
      <div class="reddit-title">
        {% if r.url %}<a href="{{ r.url }}" target="_blank" style="color:var(--fg);text-decoration:none">{{ r.title }}</a>{% else %}{{ r.title }}{% endif %}
      </div>
      {% if r.title_zh %}<div style="font-size:12px;color:var(--muted);margin-top:3px;font-style:italic">{{ r.title_zh }}</div>{% endif %}
      {% if r.body %}<div class="reddit-body" style="margin-top:6px">{{ r.body[:200] }}{% if r.body|length > 200 %}…{% endif %}</div>{% endif %}
    </div>
    {% endfor %}
    {% endif %}

    {% if not t.tiktok and not t.youtube and not t.reddit %}
    <p style="color:var(--muted);padding:24px 0">暂无社交媒体数据。运行 <code>assign-to-clusters</code> 后重新导出。</p>
    {% endif %}
  </div>

  <!-- ── 需求 tab ─────────────────────────────────────── -->
  <div class="tab-pane" data-tab="demand">
    {% if t.keywords %}
    <h3 style="margin:0 0 10px;font-size:15px">ASO 关键词（{{ t.keywords|length }}）</h3>
    <table class="cia-table display compact" style="width:100%;margin-bottom:28px">
      <thead><tr><th>关键词</th><th>搜索量</th><th>排名</th><th>App</th></tr></thead>
      <tbody>
      {% for k in t.keywords %}
      <tr>
        <td>{{ k.keyword }}</td>
        <td class="num">{{ (k.search_volume or 0)|num }}</td>
        <td class="num">{{ k.rank or "—" }}</td>
        <td style="font-size:12px;color:var(--muted)">{{ k.app_name or k.app_id }}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    {% endif %}

    {% if t.google_kw %}
    <h3 style="margin:0 0 10px;font-size:15px">Google 关键词（{{ t.google_kw|length }}）</h3>
    <table class="cia-table display compact" style="width:100%;margin-bottom:28px">
      <thead><tr><th>关键词</th><th>月搜索量</th><th>KD</th><th>CPC</th><th>Intent</th></tr></thead>
      <tbody>
      {% for k in t.google_kw %}
      <tr>
        <td>{{ k.keyword }}</td>
        <td class="num">{{ (k.volume or 0)|num }}</td>
        <td class="num"><span class="kd-{{ k.kd|kd_bucket }}">{{ k.kd or "—" }}</span></td>
        <td class="num">{{ "$%.2f"|format(k.cpc_usd) if k.cpc_usd else "—" }}</td>
        <td>{% if k.intent %}<span class="intent-{{ k.intent }}">{{ k.intent }}</span>{% else %}—{% endif %}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    {% endif %}

    {% if not t.keywords and not t.google_kw %}
    <p style="color:var(--muted);padding:24px 0">暂无需求数据。</p>
    {% endif %}
  </div>

  <!-- ── 供给 tab ─────────────────────────────────────── -->
  <div class="tab-pane" data-tab="supply">
    {% if t.apps %}
    <h3 style="margin:0 0 10px;font-size:15px">🏢 竞品 App（{{ t.apps|length }}）</h3>
    <table class="cia-table display compact" style="width:100%;margin-bottom:28px">
      <thead><tr><th>App</th><th>开发者</th><th>评分</th><th>评论数</th><th>定价</th><th>分类</th><th>链接</th></tr></thead>
      <tbody>
      {% for a in t.apps %}
      <tr>
        <td><b>{{ a.name }}</b></td>
        <td>{{ a.developer }}</td>
        <td class="num">{{ "%.1f"|format(a.rating) if a.rating else "—" }}</td>
        <td class="num">{{ (a.review_count or 0)|num }}</td>
        <td>{{ a.price or "免费" }}</td>
        <td style="font-size:12px">{{ a.category }}</td>
        <td class="url-cell">{% if a.url %}<a href="{{ a.url }}" target="_blank">App Store ↗</a>{% endif %}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    {% endif %}

    {% if t.web_comps %}
    <h3 style="margin:0 0 10px;font-size:15px">🌐 竞品官网（{{ t.web_comps|length }}）</h3>
    {% set max_t = t.web_comps[0].monthly_organic_traffic if t.web_comps else 1 %}
    {% for c in t.web_comps %}
    <div style="background:var(--card);border:1px solid var(--border);border-radius:8px;padding:12px 14px;margin-bottom:8px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
        <a href="https://{{ c.domain }}" target="_blank" style="font-weight:600;font-size:13px;color:var(--blue);text-decoration:none">{{ c.domain }}</a>
        <span style="font-weight:700;font-size:14px">{{ (c.monthly_organic_traffic or 0)|num }}<span style="font-size:11px;font-weight:400;color:var(--muted)">/月</span></span>
      </div>
      <div class="comp-bar-wrap">
        <div class="comp-bar" style="width:{{ [((c.monthly_organic_traffic or 0) / ([max_t, 1]|max) * 100)|int, 100]|min }}%"></div>
      </div>
    </div>
    {% endfor %}
    {% endif %}

    {% if t.reviews %}
    <h3 style="margin:24px 0 10px;font-size:15px">💔 差评（{{ t.reviews|length }}）</h3>
    {% for r in t.reviews %}
    <div class="review-item">
      <div class="review-stars">{{ "★" * (r.rating|int) }}{{ "☆" * (5 - r.rating|int) }} {{ r.rating }}/5</div>
      <div class="review-body">{{ r.body }}</div>
      <div class="review-meta">{{ r.app_id }} · {{ r.posted_at }}</div>
    </div>
    {% endfor %}
    {% endif %}

    {% if not t.apps and not t.web_comps %}
    <p style="color:var(--muted);padding:24px 0">暂无供给数据。</p>
    {% endif %}
  </div>

</section>
{% endfor %}

