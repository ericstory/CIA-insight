  </table>
</section>

<!-- ══════════ BRIEFS ══════════ -->
{% if briefs %}
<section class="page-section" data-route="/briefs">
  <div class="page-head">
    <h2>🎬 内容简报</h2>
    <div class="sub">每个赛道的爆款洞察 · 可直接输入 mobile-opr /produce</div>
  </div>

  {% for b in briefs %}
  <div class="brief-card">
    <div class="brief-card-head">
      <div>
        <div class="brief-card-title">{{ b.name_en }}</div>
        <div class="brief-card-sub">{{ b.name }} · TikTok {{ b.tiktok_count }} · YouTube {{ b.youtube_count }}</div>
      </div>
      <div class="brief-actions">
        <button class="btn-copy" onclick="copyBrief(this, 'brief-md-{{ loop.index }}')">复制 Brief</button>
        <button class="btn-dl"   onclick="downloadBrief('brief-md-{{ loop.index }}', '{{ b.md_filename }}')">下载 .md</button>
      </div>
    </div>

    {% if b.viral_hooks %}
    <div class="brief-section-label">爆款钩子</div>
    <div class="hook-list">
      {% for h in b.viral_hooks %}<span class="hook-tag">{{ h }}</span>{% endfor %}
    </div>
    {% endif %}

    {% if b.audience_language %}
    <div class="brief-section-label">受众语言</div>
    <ul class="quote-list">
      {% for p in b.audience_language %}<li>{{ p }}</li>{% endfor %}
    </ul>
    {% endif %}

    {% if b.content_angle %}
    <div class="brief-section-label">建议内容角度</div>
    <div class="angle-box">{{ b.content_angle }}</div>
    {% endif %}

    {% if b.hashtags %}
    <div class="brief-section-label">话题标签</div>
    <div class="hashtag-row">
      {% for tag in b.hashtags %}<span class="hashtag">{{ tag }}</span>{% endfor %}
    </div>
    {% endif %}

    <button class="brief-raw-toggle" onclick="toggleRaw(this)">▸ 展开原始数据</button>
    <div class="brief-raw">
      {% if b.top_tiktok %}
      <div style="font-size:12px;font-weight:600;margin:10px 0 6px">TikTok Top {{ b.top_tiktok|length }}</div>
      <table>
        <thead><tr><th>播放</th><th>内容</th><th>链接</th></tr></thead>
        <tbody>
        {% for v in b.top_tiktok %}
        <tr>
          <td style="white-space:nowrap">{{ v.plays | default(0) | int | string }}</td>
          <td>{{ (v.text or "")|truncate(120) }}</td>
          <td><a href="{{ v.url }}" target="_blank">↗</a></td>
        </tr>
        {% endfor %}
        </tbody>
      </table>
      {% endif %}

      {% if b.top_youtube %}
      <div style="font-size:12px;font-weight:600;margin:14px 0 6px">YouTube Top {{ b.top_youtube|length }}</div>
      <table>
        <thead><tr><th>播放</th><th>标题</th><th>链接</th></tr></thead>
        <tbody>
        {% for v in b.top_youtube %}
        <tr>
          <td style="white-space:nowrap">{{ v.views | default(0) | int | string }}</td>
          <td>{{ (v.title or "")|truncate(100) }}</td>
          <td><a href="{{ v.url }}" target="_blank">↗</a></td>
        </tr>
        {% endfor %}
        </tbody>
      </table>
      {% endif %}
    </div>

    {# Hidden md content for copy/download #}
    <textarea id="brief-md-{{ loop.index }}" style="display:none">{{ b.md_content }}</textarea>
  </div>
  {% endfor %}
</section>
{% endif %}

</main>

<!-- JS -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/2.1.8/js/dataTables.min.js"></script>
<script src="https://cdn.datatables.net/buttons/3.2.0/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/3.2.0/js/buttons.html5.min.js"></script>
<script>
// ── Hash Router ────────────────────────────────────────────────────────────
const sections = document.querySelectorAll('.page-section');
const navLinks  = document.querySelectorAll('a[data-nav]');
const dtInited  = new Set();

function getRoute() {
  return location.hash.replace(/^#/, '') || '/overview';
}

function activate() {
  const route = getRoute();
  sections.forEach(s => {
    const active = s.dataset.route === route;
    s.classList.toggle('active', active);
    if (active && !dtInited.has(route)) {
      s.querySelectorAll('table.cia-table').forEach(t => {
        if (!$.fn.dataTable.isDataTable(t)) {
          $(t).DataTable({
            pageLength: 25,
            order: [],
            scrollX: true,
            dom: 'Bfrtip',
            buttons: [{ extend:'csv', text:'⬇ CSV' }]
          });
        }
      });
      dtInited.add(route);
    }
  });
  navLinks.forEach(a => {
    a.classList.toggle('active', a.getAttribute('href') === '#' + route);
  });
  window.scrollTo(0, 0);
}

window.addEventListener('hashchange', activate);
// Handle data-nav clicks (works for both <a> and cards)
document.addEventListener('click', e => {
  const a = e.target.closest('[data-nav]');
  if (a && a.getAttribute('href')?.startsWith('#')) {
    e.preventDefault();
    location.hash = a.getAttribute('href').slice(1);
  }
});
activate();

// ── TikTok filters ─────────────────────────────────────────────────────────
function filterTT(mode, btn) {
  document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.tt-card').forEach(card => {
    const sr   = parseFloat(card.dataset.sr || 0);
    const plays = parseInt(card.dataset.plays || 0);
    let show = true;
    if (mode === 'hot')  show = sr >= 0.01;
    if (mode === '100k') show = plays >= 100000;
    card.style.display = show ? '' : 'none';
  });
}

// ── Generic card search ────────────────────────────────────────────────────
function filterCards(cls, q) {
  const lq = q.toLowerCase();
  document.querySelectorAll('.' + cls).forEach(card => {
    const text = card.dataset.text || '';
    const auth = card.dataset.author || '';
    const qry  = card.dataset.query || '';
    card.style.display = (!lq || text.includes(lq) || auth.includes(lq) || qry.includes(lq)) ? '' : 'none';
  });
}

// ── Track three-layer tabs ─────────────────────────────────────────────────
function switchTab(trackId, tabName, btn) {
  const sec = document.querySelector('[data-route="/track/' + trackId + '"]');
  if (!sec) return;
  sec.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  sec.querySelectorAll('.tab-pane').forEach(p => {
    p.classList.toggle('active', p.dataset.tab === tabName);
  });
}

// ── Brief copy / download / toggle ────────────────────────────────────────
function copyBrief(btn, textareaId) {
  const content = document.getElementById(textareaId)?.value || '';
  navigator.clipboard.writeText(content).then(() => {
    const orig = btn.textContent;
    btn.textContent = '✓ 已复制';
    btn.classList.add('copied');
    setTimeout(() => { btn.textContent = orig; btn.classList.remove('copied'); }, 2000);
  }).catch(() => {
    // Fallback for non-https
    const ta = document.getElementById(textareaId);
    ta.style.display = 'block';
    ta.select();
    document.execCommand('copy');
    ta.style.display = 'none';
  });
}

function downloadBrief(textareaId, filename) {
  const content = document.getElementById(textareaId)?.value || '';
  const blob = new Blob([content], { type: 'text/markdown;charset=utf-8' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = filename || 'brief.md';
  a.click();
  URL.revokeObjectURL(a.href);
}

function toggleRaw(btn) {
  const raw = btn.nextElementSibling;
  const open = raw.classList.toggle('open');
  btn.textContent = (open ? '▾ 收起原始数据' : '▸ 展开原始数据');
}
</script>
</body>
</html>
