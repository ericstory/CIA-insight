<!-- ══════════ LOG ══════════ -->
<section class="page-section" data-route="/log">
  <div class="page-head">
    <h2>Fetch Log</h2>
    <div class="sub">数据采集记录 · 总成本 ${{ "%.4f"|format(total_cost) }}</div>
  </div>
  <table class="cia-table display compact" id="dt-log" style="width:100%">
    <thead><tr><th>时间</th><th>来源</th><th>操作</th><th>行数</th><th>耗时</th><th>成本</th></tr></thead>
