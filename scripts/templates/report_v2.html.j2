<!-- ══════════ GOOGLE KW ══════════ -->
<section class="page-section" data-route="/keywords/google">
  <div class="page-head">
    <h2>Google 关键词</h2>
    <div class="sub">{{ kw_all|length }} 条 · 来自 Ahrefs Keywords Explorer</div>
  </div>
  <table class="cia-table display compact" id="dt-kw-google" style="width:100%">
    <thead><tr><th>关键词</th><th>月搜索量</th><th>KD</th><th>CPC</th><th>Intent</th><th>国家</th><th>来源</th><th>溯源</th></tr></thead>
