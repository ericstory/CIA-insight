    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
      <div>
        <a href="https://{{ c.domain }}" target="_blank" style="font-weight:600;font-size:14px;color:var(--blue);text-decoration:none">{{ c.domain }}</a>
        <span style="font-size:12px;color:var(--muted);margin-left:10px">{{ (c.organic_keywords_count or 0)|num }} 个 KW</span>
      </div>
      <div style="font-size:16px;font-weight:700">{{ (c.monthly_organic_traffic or 0)|num }}<span style="font-size:11px;font-weight:400;color:var(--muted)"> /月</span></div>
    </div>
