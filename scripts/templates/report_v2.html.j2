  {% if kw_golden %}
  <table class="cia-table display compact" id="dt-kw-golden" style="width:100%">
    <thead><tr><th>关键词</th><th>月搜索量</th><th>KD</th><th>CPC</th><th>Intent</th><th>溯源</th></tr></thead>
    <tbody>
    {% for k in kw_golden %}
    <tr>
      <td><b>{{ k.keyword }}</b></td>
      <td class="num">{{ (k.volume or 0)|num }}</td>
      <td class="num"><span class="kd-{{ k.kd|kd_bucket }}">{{ k.kd or "—" }}</span></td>
      <td class="num">{{ "$%.2f"|format(k.cpc_usd) if k.cpc_usd else "—" }}</td>
      <td>{% if k.intent %}<span class="intent-{{ k.intent }}">{{ k.intent }}</span>{% else %}—{% endif %}</td>
      <td class="url-cell"><a href="https://www.google.com/search?q={{ k.keyword }}" target="_blank">🔍</a></td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p style="color:var(--muted)">当前数据集中暂无满足条件的 Golden Keywords（vol≥200 + KD≤35 + CPC≥$1）。</p>
  {% endif %}
</section>

